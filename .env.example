# Postgres connection string from Neon (use the pooled one).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Any long random string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app runs: http://localhost:3000 locally, https://dump.abulhassan.dev live.
BETTER_AUTH_URL="http://localhost:3000"
